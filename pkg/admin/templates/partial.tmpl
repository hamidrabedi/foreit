<div id="table-container">
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    {{if index .Model "ListDisplay"}}
                    {{range $fieldName := index .Model "ListDisplay"}}
                    <th>{{$fieldName}}</th>
                    {{end}}
                    {{else}}
                    <th>Details</th>
                    {{end}}
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{range .Objects}}
                <tr>
                    <td>{{.ID}}</td>
                    {{if index $.Model "ListDisplay"}}
                    {{range $fieldName := index $.Model "ListDisplay"}}
                    {{if $fieldNameStr := $fieldName}}
                    <td class="editable-cell" 
                        hx-get="{{$.BaseURL}}{{.ID}}/edit-field/{{$fieldNameStr}}/"
                        hx-trigger="dblclick"
                        hx-target="this"
                        hx-swap="outerHTML"
                        style="cursor: pointer;"
                        title="Double-click to edit">
                        {{index .Fields $fieldNameStr}}
                    </td>
                    {{else}}
                    <td>-</td>
                    {{end}}
                    {{end}}
                    {{else}}
                    {{range $key, $value := .Fields}}
                    <td>{{$value}}</td>
                    {{end}}
                    {{end}}
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="{{.Actions.view}}" class="btn btn-outline-primary">View</a>
                            <a href="{{.Actions.edit}}" class="btn btn-outline-secondary">Edit</a>
                            <button type="button" 
                                    class="btn btn-outline-danger"
                                    hx-delete="{{$.BaseURL}}{{.ID}}/delete/"
                                    hx-confirm="Are you sure you want to delete this item?"
                                    hx-target="closest tr"
                                    hx-swap="outerHTML swap:1s">
                                Delete
                            </button>
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            {{if gt .Page 1}}
            <li class="page-item">
                <a class="page-link" 
                   href="{{.BaseURL}}?page={{sub .Page 1}}"
                   hx-get="{{.BaseURL}}?page={{sub .Page 1}}"
                   hx-target="#table-container"
                   hx-swap="outerHTML"
                   hx-push-url="true">Previous</a>
            </li>
            {{else}}
            <li class="page-item disabled">
                <span class="page-link">Previous</span>
            </li>
            {{end}}
            <li class="page-item active">
                <span class="page-link">Page {{.Page}} of {{.TotalPages}}</span>
            </li>
            {{if lt .Page .TotalPages}}
            <li class="page-item">
                <a class="page-link" 
                   href="{{.BaseURL}}?page={{add .Page 1}}"
                   hx-get="{{.BaseURL}}?page={{add .Page 1}}"
                   hx-target="#table-container"
                   hx-swap="outerHTML"
                   hx-push-url="true">Next</a>
            </li>
            {{else}}
            <li class="page-item disabled">
                <span class="page-link">Next</span>
            </li>
            {{end}}
        </ul>
    </nav>
</div>
